{
  "name": "@vistecsol/paperclip-figma-integration",
  "version": "0.1.0-alpha.1",
  "description": "Paperclip Figma integration engineering preview; host prerequisites required",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/vistecsol/paperclip-figma-integration.git"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "src",
    "test",
    "migrations",
    "docs",
    "host-prerequisite",
    "scripts",
    "README.md",
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./attachments": "./src/attachments.mjs",
    "./storage": "./src/storage.mjs",
    "./api": "./src/api.mjs",
    "./discovery": "./src/discovery.mjs",
    "./service": "./src/service.mjs",
    "./managed-bridge": "./src/managed-bridge.mjs",
    "./source-registry": "./src/source-registry.mjs",
    "./worker": "./src/worker.mjs",
    "./host-operations": "./src/host-operations.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs && git diff --check",
    "prepack": "npm run check && npm test && node scripts/verify-build.mjs",
    "build": "node scripts/build.mjs"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.mjs",
    "worker": "./dist/worker.mjs"
  }
}
